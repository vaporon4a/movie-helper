# Получите токен у @BotFather. Настоящие ключи сюда не вставлять.
BOT_TOKEN=
# ID групп через запятую. Команда /id@имя_бота работает до добавления в список.
# Для первого запуска без разрешённых групп используйте bootstrap.
ALLOWED_CHAT_IDS=bootstrap
LOG_LEVEL=INFO
MEME_SUBREDDITS=RUSSIANMemeSub
# Для автоматического отбора нужен хотя бы один ключ: Gemini или Groq.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Общий лимит попыток в UTC-сутки, сохраняется при перезапуске; 0 отключает вызовы.
GEMINI_DAILY_REQUEST_LIMIT=20
# Резерв при ошибке Gemini; работает самостоятельно, если Gemini не настроен.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Отдельный сохраняемый лимит попыток Groq в UTC-сутки.
GROQ_DAILY_REQUEST_LIMIT=20
# Необязательно: названия статей английской Wikipedia, разделитель |.
# Пустое значение включает встроенный список из 20 фильмов.
FACT_WIKI_TITLES=
# Для запуска опубликованного образа задайте SHA-тег из GitHub Actions.
# BOT_IMAGE=ghcr.io/vaporon4a/movie-helper:sha-<commit>
